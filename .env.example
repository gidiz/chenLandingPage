NUXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NUXT_PUBLIC_GTM_CONTAINER_ID=GTM-XXXXXXX
NUXT_PUBLIC_GTM_AUTH=
NUXT_PUBLIC_GTM_PREVIEW=
NUXT_PUBLIC_GTM_COOKIES_WIN=x
NUXT_PUBLIC_APP_ENVIRONMENT=development
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
RAG_CHAT_RATE_LIMIT_WINDOW_MS=60000
RAG_CHAT_RATE_LIMIT_MAX_REQUESTS=8
RAG_CHAT_OPENAI_TIMEOUT_MS=15000
RAG_CHAT_OPENAI_MAX_ATTEMPTS=3
RAG_CHAT_RETRIEVAL_TOP_K=6

# Private server runtime settings. Never use NUXT_PUBLIC_*.
# Required exact HTTPS browser origin, no trailing slash/path/credentials.
# Safe syntax example only: CONTACT_CANONICAL_ORIGIN=https://clinic.example.invalid
# Set the actual approved site origin separately for each runtime, including Preview.
CONTACT_CANONICAL_ORIGIN=
# Optional comma-separated exact socket peer IPs, at most 32; no CIDRs/hostnames/*.
# Empty means NO proxy trust; all forwarded headers are ignored.
# Safe example only: CONTACT_TRUSTED_PROXY_IPS=192.0.2.10,::ffff:192.0.2.10
# Enable ONLY after verifying ingress strips incoming X-Forwarded-For and writes
# exactly one validated client IP, and untrusted traffic cannot use those peers.
# Trusted peers with missing/malformed/multi-hop X-Forwarded-For receive 400.
# Forwarded host/protocol headers are never trusted for origin validation.
CONTACT_TRUSTED_PROXY_IPS=
# Configure at least one fixed HTTPS destination, no URL credentials or fragments.
# Safe syntax examples only (not functional destinations):
# CONTACT_MAKE_WEBHOOK_URL=https://make.example.invalid/contact
# CONTACT_LAMBDA_URL=https://lambda.example.invalid/contact
# Clinic owner: rotate/revoke the exposed Make webhook, then set ONLY its NEW URL.
# Do not reuse the legacy URL. No fallback is provided; neither configured returns 503.
CONTACT_MAKE_WEBHOOK_URL=
# Set the existing clinic AWS contact destination in the server environment.
# Configured destinations receive the same four-field JSON. Any 2xx is acceptance.
# Either successful POST returns 200; deliveryStatus=partial if another configured
# destination fails. One intentionally configured destination succeeds as complete.
CONTACT_LAMBDA_URL=
# Deploy a Nitro server and route same-origin POST /api/contact to it.
# Static S3 hosting alone cannot serve this endpoint. Do not enable wildcard CORS.
# Set these vars on the running server (not just the static build job).
# Rate limit: 5 requests/minute per socket IP (or verified single forwarded client IP).
# Shared store/edge enforcement required for serverless or multiple instances.
# Without verified proxy trust, shared socket peers share a quota.
# Nuxt runtime aliases: NUXT_CONTACT_CANONICAL_ORIGIN, NUXT_CONTACT_TRUSTED_PROXY_IPS,
# NUXT_CONTACT_MAKE_WEBHOOK_URL, NUXT_CONTACT_LAMBDA_URL. CONTACT_* takes precedence,
# including explicitly empty values. Do not set conflicting aliases.

AWS_REGION=us-east-1

# Optional. If omitted, the AWS SDK default credential chain is used.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=



# Optional for higher GitHub rate limits and private repository access.
GITHUB_TOKEN=

# Optional override. Defaults to gidiz/chenLandingPage.
GITHUB_REPOSITORY=gidiz/chenLandingPage