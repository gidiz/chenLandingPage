NUXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NUXT_PUBLIC_GTM_CONTAINER_ID=GTM-XXXXXXX
NUXT_PUBLIC_GTM_AUTH=
NUXT_PUBLIC_GTM_PREVIEW=
NUXT_PUBLIC_GTM_COOKIES_WIN=x
NUXT_PUBLIC_APP_ENVIRONMENT=development
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
RAG_CHAT_RATE_LIMIT_WINDOW_MS=60000
RAG_CHAT_RATE_LIMIT_MAX_REQUESTS=8
RAG_CHAT_OPENAI_TIMEOUT_MS=15000
RAG_CHAT_OPENAI_MAX_ATTEMPTS=3
RAG_CHAT_RETRIEVAL_TOP_K=6

# Private server runtime settings: configure at least one. Never use NUXT_PUBLIC_*.
# Clinic owner: rotate/revoke the exposed Make webhook, then set ONLY its NEW URL.
# Do not reuse the legacy URL. No fallback is provided; neither configured returns 503.
CONTACT_MAKE_WEBHOOK_URL=
# Set the existing clinic AWS contact destination in the server environment.
# Configured destinations receive the same four-field JSON; either successful POST is success.
CONTACT_LAMBDA_URL=
# Deploy a Nitro server and route same-origin POST /api/contact to it.
# Static S3 hosting alone cannot serve this endpoint. Do not enable wildcard CORS.
# Set these vars on the running server (not just the static build job).
# Rate limit: 5 requests/minute per socket IP; shared store required for multiple instances.
# Behind a proxy, socket IPs may share a quota. Do not trust unfiltered forwarded headers.

AWS_REGION=us-east-1

# Optional. If omitted, the AWS SDK default credential chain is used.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=



# Optional for higher GitHub rate limits and private repository access.
GITHUB_TOKEN=

# Optional override. Defaults to gidiz/chenLandingPage.
GITHUB_REPOSITORY=gidiz/chenLandingPage