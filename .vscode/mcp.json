{
  "inputs": [
    {
      "type": "promptString",
      "id": "supabase-access-token",
      "description": "Supabase personal access token (sbp_...)",
      "password": true
    }
  ],
  "servers": {
    "chenIntegrations": {
      "type": "stdio",
      "command": "npm",
      "args": ["run", "mcp:start"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "dev": {
        "watch": ["server/mcp/**/*.ts"]
      }
    },
    "github": {
      "type": "stdio",
      "command": "C:\\Users\\User\\.github-mcp\\github-mcp-server.exe",
      "args": ["stdio"],
      "envFile": "${workspaceFolder}/.env"
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com/gidis-projects/chen-landing-page"
    },
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=giaahwesswfnwxltjtdi&features=database,docs,debugging,development",
      "headers": {
        "Authorization": "Bearer ${input:supabase-access-token}"
      }
    }
  }
}